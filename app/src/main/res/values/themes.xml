<resources>
    <!-- Base application theme. -->
    <style name="Theme.NaviAOD" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorPrimaryVariant">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/oled_black</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Always On Display (AOD) Fullscreen Theme: PURE OLED BLACK (#000000) -->
    <style name="Theme.NaviAOD.AodFullscreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/oled_black</item>
        <item name="android:colorBackground">@color/oled_black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/oled_black</item>
        <item name="android:navigationBarColor">@color/oled_black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
